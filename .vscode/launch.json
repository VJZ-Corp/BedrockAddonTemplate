{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Minecraft Local Deploy",
      "skipFiles": [ "<node_internals>/**" ],
      "runtimeExecutable": "npm",
      "args": [ "run", "local-deploy" ],
      "cwd": "${workspaceFolder}",
      "console": "integratedConsole"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Build Release Distribution",
      "skipFiles": [ "<node_internals>/**" ],
      "runtimeExecutable": "npm",
      "args": [ "run", "mcaddon" ],
      "cwd": "${workspaceFolder}",
      "console": "integratedConsole"
    }
  ]
}
